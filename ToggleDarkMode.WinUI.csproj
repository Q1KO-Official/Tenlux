<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Tenlux</RootNamespace>
    <AssemblyName>Tenlux</AssemblyName>
    <AssemblyTitle>Tenlux</AssemblyTitle>
    <Product>Tenlux</Product>
    <Description>Lightweight Windows light/dark mode switcher with tray controls, wallpaper automation, hotkeys, and scheduled switching.</Description>
    <Company>Q1KO</Company>
    <Authors>Q1KO</Authors>
    <Copyright>Copyright (c) 2026 Q1KO</Copyright>
    <RepositoryUrl>https://github.com/Q1KO-Official/Tenlux</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Q1KO-Official/Tenlux</PackageProjectUrl>
    <PackageTags>windows;winui3;theme;tray;wallpaper;productivity</PackageTags>
    <Version>2.0.0-preview</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <InformationalVersion>2.0.0Preview</InformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="Assets\**\*" />
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="RELEASE.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="SUPPORT.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="LICENSE.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
    <!-- Exclude unnecessary ML/AI transitive packages to reduce installed size -->
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.1.1" PrivateAssets="all" ExcludeAssets="compile;runtime;native" />
  </ItemGroup>


  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun>False</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>

  <!-- Copy XAML compiled resources and Assets to publish output -->
  <Target Name="CopyXamlToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_XbfFiles Include="$(OutputPath)*.xbf" />
      <_XbfPages Include="$(OutputPath)Pages\*.xbf" />
      <_PriFile Include="$(OutputPath)$(AssemblyName).pri" />
      <_Assets Include="$(MSBuildProjectDirectory)\Assets\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_XbfFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_XbfPages)" DestinationFolder="$(PublishDir)Pages\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PriFile)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_Assets)" DestinationFolder="$(PublishDir)Assets\%(RecursiveDir)" SkipUnchangedFiles="false" />
  </Target>

  <!-- Remove unused native/projection DLLs from publish output -->
  <Target Name="RemoveUnusedDependencies" AfterTargets="CopyXamlToPublish">
    <ItemGroup>
      <_RemoveFiles Include="$(PublishDir)onnxruntime.dll" />
      <_RemoveFiles Include="$(PublishDir)DirectML.dll" />
      <_RemoveFiles Include="$(PublishDir)Microsoft.Windows.AI.MachineLearning.dll" />
      <_RemoveFiles Include="$(PublishDir)Microsoft.ML.OnnxRuntime.dll" />
      <_RemoveFiles Include="$(PublishDir)System.Numerics.Tensors.dll" />
      <_RemoveFiles Include="$(PublishDir)Microsoft.Web.WebView2.Core.dll" />
      <_RemoveFiles Include="$(PublishDir)Microsoft.Web.WebView2.Core.Projection.dll" />
      <_RemoveFiles Include="$(PublishDir)WebView2Loader.dll" />
      <_RemoveFiles Include="$(PublishDir)Microsoft.Windows.Widgets.Projection.dll" />
      <_RemoveFiles Include="$(PublishDir)Microsoft.Windows.AI.Text.Projection.dll" />
      <_RemoveFiles Include="$(PublishDir)Microsoft.Windows.AI.MachineLearning.Projection.dll" />
      <_RemoveFiles Include="$(PublishDir)Microsoft.Windows.AI.Imaging.Projection.dll" />
      <_RemoveFiles Include="$(PublishDir)Microsoft.Windows.AI.ContentSafety.Projection.dll" />
      <_RemoveFiles Include="$(PublishDir)Microsoft.Windows.AI.Projection.dll" />
      <_RemoveFiles Include="$(PublishDir)Microsoft.Windows.AI.Foundation.Projection.dll" />
      <_RemoveFiles Include="$(PublishDir)Microsoft.Graphics.Imaging.Projection.dll" />
    </ItemGroup>
    <Delete Files="@(_RemoveFiles)" />
  </Target>
</Project>
