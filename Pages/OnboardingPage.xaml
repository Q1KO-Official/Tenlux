<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Tenlux.Pages.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="40" />
            </TransitionCollection>
        </Grid.ChildrenTransitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Welcome Page (shown on step 0) -->
        <StackPanel x:Name="WelcomePanel"
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,124,0,0"
                    Spacing="10"
                    Padding="20">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="30" IsStaggeringEnabled="True" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="20"
                    Width="56" Height="56"
                    HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE790;" FontSize="36" Foreground="White"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="TxtWelcomeAppName"
                       Style="{StaticResource TitleTextBlockStyle}"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="WelcomeDesc"
                       Style="{StaticResource BodyTextBlockStyle}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       MaxWidth="360" />
            <TextBlock x:Name="WelcomeHint"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Opacity="0.56"
                       TextWrapping="Wrap"
                       MaxWidth="420" />
            <ComboBox x:Name="CmbLang"
                      AutomationProperties.AutomationId="OnboardingLanguageComboBox"
                      HorizontalAlignment="Center"
                      Width="180"
                      SelectionChanged="OnLangChanged" />
            <Button x:Name="BtnWelcomeNext"
                    AutomationProperties.AutomationId="OnboardingWelcomeNextButton"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0"
                    MinWidth="160"
                    Click="OnNext" />
        </StackPanel>

        <!-- Feature Pages (shown on steps 1-4) -->
        <Grid x:Name="FeaturePanel"
              Grid.Row="0"
              Visibility="Collapsed">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="30" />
                </TransitionCollection>
            </Grid.ChildrenTransitions>

            <!-- Feature 1: Theme Toggle -->
            <StackPanel x:Name="Feature1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,160,0,0"
                        Spacing="8" Padding="20" Visibility="Collapsed">
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="22" Width="64" Height="64"
                        HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE771;" FontSize="36" Foreground="White"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="Feature1Title"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="Feature1Desc"
                           Style="{StaticResource BodyTextBlockStyle}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Opacity="0.7" TextWrapping="Wrap" MaxWidth="360" />
            </StackPanel>

            <!-- Feature 2: Wallpaper Automation -->
            <StackPanel x:Name="Feature2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,160,0,0"
                        Spacing="8" Padding="20" Visibility="Collapsed">
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="22" Width="64" Height="64"
                        HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE91B;" FontSize="36" Foreground="White"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="Feature2Title"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="Feature2Desc"
                           Style="{StaticResource BodyTextBlockStyle}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Opacity="0.7" TextWrapping="Wrap" MaxWidth="360" />
            </StackPanel>

            <!-- Feature 3: Custom Hotkeys -->
            <StackPanel x:Name="Feature3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,160,0,0"
                        Spacing="8" Padding="20" Visibility="Collapsed">
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="22" Width="64" Height="64"
                        HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE765;" FontSize="36" Foreground="White"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="Feature3Title"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="Feature3Desc"
                           Style="{StaticResource BodyTextBlockStyle}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Opacity="0.7" TextWrapping="Wrap" MaxWidth="360" />
            </StackPanel>

            <!-- Feature 4: Auto Start -->
            <StackPanel x:Name="Feature4" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,160,0,0"
                        Spacing="8" Padding="20" Visibility="Collapsed">
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="22" Width="64" Height="64"
                        HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE7E8;" FontSize="36" Foreground="White"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="Feature4Title"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="Feature4Desc"
                           Style="{StaticResource BodyTextBlockStyle}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Opacity="0.7" TextWrapping="Wrap" MaxWidth="360" />
            </StackPanel>
        </Grid>

        <!-- Ready Page -->
        <StackPanel x:Name="ReadyPanel" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,160,0,0"
                    Spacing="8" Padding="20" Visibility="Collapsed">
            <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="22" Width="64" Height="64"
                    HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE73E;" FontSize="36" Foreground="White"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="ReadyTitle"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="ReadyDesc"
                       Style="{StaticResource BodyTextBlockStyle}"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Opacity="0.7" TextWrapping="Wrap" MaxWidth="360" />
        </StackPanel>

        <!-- Bottom Navigation -->
        <Grid Grid.Row="1" Padding="24,8,24,20">
            <!-- Dots indicator (always centered) -->
            <StackPanel x:Name="DotsPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8" />

            <!-- Buttons overlay -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <HyperlinkButton x:Name="BtnSkip"
                                     AutomationProperties.AutomationId="OnboardingSkipButton"
                                     Click="OnSkip" />
                    <HyperlinkButton x:Name="BtnPrev"
                                     AutomationProperties.AutomationId="OnboardingPreviousButton"
                                     Click="OnPrev" />
                </StackPanel>
                <Button x:Name="BtnNext"
                        AutomationProperties.AutomationId="OnboardingNextButton"
                        Grid.Column="2"
                        Style="{StaticResource AccentButtonStyle}"
                        MinWidth="100"
                        Click="OnNext" />
            </Grid>
        </Grid>
    </Grid>
</Page>
